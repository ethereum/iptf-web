---
/*
 * /blog/{slug}/ — permanent redirect stub to /writeups/{slug}/.
 *
 * The writeups index moved from /blog/ to /writeups/ (issue #8). The /blog/
 * index itself is redirected via astro.config.mjs; per-post URLs can't be
 * enumerated there, so they're generated from the same `posts` collection
 * the real detail page uses. Keeps every inbound link and every /blog/ URL
 * already in the wild alive.
 *
 * Static output turns Astro.redirect into a meta-refresh page — GitHub Pages
 * serves no server-side redirects.
 */
import { getCollection } from 'astro:content';
import { jekyllSlugify } from '../../lib/jekyllSlug';
import { isPublished } from '../../lib/posts';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.filter((entry) => isPublished(entry)).map((entry) => ({
    params: { slug: jekyllSlugify(entry.data.title) },
  }));
}

return Astro.redirect(`/writeups/${Astro.params.slug}/`, 301);
---
